# Keep scripts runnable on the platform they are for, whatever machine commits them.
*.sh   text eol=lf
*.py   text eol=lf
*.ps1  text eol=crlf
*.bat  text eol=crlf

# Not part of the distributable Widget.zip (git archive and the release workflow)
.github export-ignore

# Release builds get the version stamped into WIDGET_VERSION (git describe)
now-playing-source.js export-subst
